rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções utilitárias de segurança
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Regra da Conta Proprietária
    match /accounts/{ownerUid} {
      allow read, write: if isOwner(ownerUid) && isValidId(ownerUid);

      // Subcoleções por ambiente (real vs demo)
      match /environments/{envId} {
        allow read, write: if isOwner(ownerUid) && isValidId(envId);

        match /leads/{leadId} {
          allow read, write: if isOwner(ownerUid) && isValidId(leadId);
        }

        match /sales/{saleId} {
          allow read, write: if isOwner(ownerUid) && isValidId(saleId);
        }

        match /tasks/{taskId} {
          allow read, write: if isOwner(ownerUid) && isValidId(taskId);
        }

        match /scripts/{scriptId} {
          allow read, write: if isOwner(ownerUid) && isValidId(scriptId);
        }

        match /creatives/{creativeId} {
          allow read, write: if isOwner(ownerUid) && isValidId(creativeId);
        }

        match /packages/{packageId} {
          allow read, write: if isOwner(ownerUid) && isValidId(packageId);
        }

        match /expenses/{expenseId} {
          allow read, write: if isOwner(ownerUid) && isValidId(expenseId);
        }

        match /experiments/{expId} {
          allow read, write: if isOwner(ownerUid) && isValidId(expId);
        }

        match /productivity/{sessId} {
          allow read, write: if isOwner(ownerUid) && isValidId(sessId);
        }

        match /settings/{settingId} {
          allow read, write: if isOwner(ownerUid) && isValidId(settingId);
        }
      }
    }

    // Bloqueio explícito de qualquer outro caminho não autorizado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
